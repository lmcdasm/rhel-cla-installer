kind: Deployment
apiVersion: apps/v1
metadata:
  name: {{ okp_name }}
  labels:
    service: rhel-lightspeed
    app: {{ okp_name }}
spec:
  replicas: {{ okp_replicas }}
  # Recreate: RWO/data volume + long index extract — do not surge a second pod.
  strategy:
    type: Recreate
  progressDeadlineSeconds: 3600

  selector:
    matchLabels:
      app: {{ okp_name }}

  template:
    metadata:
      annotations:
        configmap-hash: "tar-wrapper-v5"
      labels:
        service: rhel-lightspeed
        app: {{ okp_name }}

    spec:
      serviceAccountName: {{ okp_name }}
      volumes:
        - name: solr-data
          emptyDir: {}

        - name: tar-wrapper
          configMap:
            name: {{ okp_name }}-tar-wrapper
            defaultMode: 0755

      containers:
        - name: {{ okp_name }}
          image: {{ okp_container_image }}:{{ okp_container_image_tag }}
          ports:
            - containerPort: {{ okp_port }}
              protocol: TCP

          volumeMounts:
            - name: solr-data
              mountPath: /opt/solr/server/solr/portal/data

            - name: tar-wrapper
              mountPath: /usr/local/bin/tar
              subPath: tar

          env:
            - name: ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: {{ okp_access_key.name }}
                  key: {{ okp_access_key.key }}

            - name: SOLR_HOST_BIND
              value: {{ okp_solr_host_bind }}

            - name: SOLR_LOG_LEVEL
              value: {{ okp_solr_log_level }}

            - name: PATH
              value: /usr/local/bin:/usr/sbin:/sbin:/usr/bin:/bin

          # First boot pulls/extracts a large Lucene index; keep probes from killing it.
          # startup window ≈ initialDelay + failureThreshold*period ≈ 45m
          startupProbe:
            tcpSocket:
              port: {{ okp_port }}
            initialDelaySeconds: 120
            periodSeconds: 15
            timeoutSeconds: 5
            failureThreshold: 160

          livenessProbe:
            tcpSocket:
              port: {{ okp_port }}
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 6

          readinessProbe:
            tcpSocket:
              port: {{ okp_port }}
            periodSeconds: 15
            timeoutSeconds: 5
            failureThreshold: 6

          resources:
            requests:
              cpu: {{ okp_cpu_request }}
              memory: {{ okp_memory_request }}

            limits:
              cpu: {{ okp_cpu_limit }}
              memory: {{ okp_memory_limit }}
