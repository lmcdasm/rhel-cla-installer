apiVersion: v1
kind: Service
metadata:
  name: {{ okp_name }}
{% if cla_namespace | default('') %}
  namespace: {{ cla_namespace }}
{% endif %}
  labels:
    service: rhel-lightspeed
    app: {{ okp_name }}
    app.kubernetes.io/part-of: rhel-cla
spec:
  selector:
    app: {{ okp_name }}
  ports:
    - name: solr
      port: {{ okp_port }}
      targetPort: solr
      protocol: TCP
    - name: http
      port: {{ okp_http_port }}
      targetPort: http
      protocol: TCP
