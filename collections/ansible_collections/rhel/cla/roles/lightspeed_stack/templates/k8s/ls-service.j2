apiVersion: v1
kind: Service
metadata:
  name: {{ ls_name }}
{% if cla_namespace | default('') %}
  namespace: {{ cla_namespace }}
{% endif %}
  labels:
    service: rhel-lightspeed
    app: {{ ls_name }}
    app.kubernetes.io/part-of: rhel-cla
spec:
  selector:
    app: {{ ls_name }}
  ports:
    - name: http
      port: {{ ls_service_port }}
      targetPort: http
      protocol: TCP
