apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ ls_name }}
{% if cla_namespace | default('') %}
  namespace: {{ cla_namespace }}
{% endif %}
  labels:
    service: rhel-lightspeed
    app: {{ ls_name }}
    app.kubernetes.io/part-of: rhel-cla
spec:
  replicas: {{ ls_replicas }}
  selector:
    matchLabels:
      app: {{ ls_name }}
  template:
    metadata:
      labels:
        service: rhel-lightspeed
        app: {{ ls_name }}
        app.kubernetes.io/part-of: rhel-cla
    spec:
      serviceAccountName: {{ ls_name }}
      containers:
        - name: {{ ls_name }}
{% if ls_container_image_digest | default('') %}
          image: {{ ls_container_image }}@{{ ls_container_image_digest }}
{% else %}
          image: {{ ls_container_image }}:{{ ls_container_image_tag }}
{% endif %}
          imagePullPolicy: IfNotPresent
          args:
            - --config
            - /app-root/lightspeed-stack.yml
          ports:
            - name: http
              containerPort: {{ ls_port }}
              protocol: TCP
          env:
            - name: SQLITE_STORE_DIR
              value: /tmp/llama-store
          volumeMounts:
            - name: stack-config
              mountPath: /app-root/lightspeed-stack.yml
              subPath: lightspeed-stack.yml
              readOnly: true
            - name: stack-config
              mountPath: /app-root/llama-stack.yml
              subPath: llama-stack.yml
              readOnly: true
            - name: stack-config
              mountPath: /app-root/system_prompt.txt
              subPath: system_prompt.txt
              readOnly: true
          livenessProbe:
            httpGet:
              path: /api/lightspeed/liveness
              port: http
            initialDelaySeconds: 15
            periodSeconds: 15
            failureThreshold: 5
          readinessProbe:
            httpGet:
              path: /api/lightspeed/liveness
              port: http
            initialDelaySeconds: 10
            periodSeconds: 15
            failureThreshold: 5
          resources:
            requests:
              cpu: {{ ls_cpu_request }}
              memory: {{ ls_memory_request }}
            limits:
              cpu: {{ ls_cpu_limit }}
              memory: {{ ls_memory_limit }}
      volumes:
        - name: stack-config
          configMap:
            name: {{ ls_name }}-config
