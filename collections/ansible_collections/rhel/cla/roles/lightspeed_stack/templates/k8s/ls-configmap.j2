apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ ls_name }}-config
{% if cla_namespace | default('') %}
  namespace: {{ cla_namespace }}
{% endif %}
  labels:
    service: rhel-lightspeed
    app: {{ ls_name }}
    app.kubernetes.io/part-of: rhel-cla
data:
  lightspeed-stack.yml: |
{{ lookup('template', 'lightspeed-stack-' ~ _ls_major_version ~ '.yml') | indent(4, first=True) }}
  llama-stack.yml: |
{{ lookup('template', 'providers/' ~ rhel_cla_provider ~ '/llama-stack.yml') | indent(4, first=True) }}
  system_prompt.txt: |
{{ lookup('template', 'system_prompt.txt') | regex_replace('^#jinja2:[^\n]*\n', '') | indent(4, first=True) }}
