kind: ConfigMap
apiVersion: v1
metadata:
  name: "${NAME}-run-config"
  annotations:
    qontract.recycle: "true"
  labels:
    service: rhel-lightspeed
    app: "${NAME}"
data:
  run.yaml: |
    version: 2
    image_name: vertexai-configuration
    external_providers_dir: /app-root/providers.d
    apis:
      - inference
      - agents
      - safety
      - vector_io
      - files
      - tool_runtime
    providers:
      inference:
        - provider_id: google-vertex
          provider_type: remote::vertexai
          config:
            project: ${env.VERTEXAI_PROJECT_ID}
            location: ${env.VERTEX_AI_LOCATION}
      agents:
        - provider_id: meta-reference
          provider_type: inline::meta-reference
          config:
            persistence:
              agent_state:
                backend: kv_default
                namespace: agents
              responses:
                backend: sql_default
                table_name: responses
      safety:
        - provider_id: llama-guard
          provider_type: inline::llama-guard
          config: {}
      vector_io:
        - provider_id: faiss
          provider_type: inline::faiss
          config:
            persistence:
              backend: kv_default
              namespace: "vector_io::faiss"
      files:
        - provider_id: meta-reference-files
          provider_type: inline::localfs
          config:
            storage_dir: /tmp/files
            metadata_store:
              backend: sql_default
              table_name: files_metadata
      tool_runtime:
        - provider_id: rag-runtime
          provider_type: inline::rag-runtime
          config: {}
        - provider_id: model-context-protocol
          provider_type: remote::model-context-protocol
          config: {}
    # Explicit storage section overrides StorageConfig's Pydantic
    # default, which embeds literal SQLITE_STORE_DIR env var strings
    # that bypass replace_env_vars() and crash on read-only
    # filesystems.  See https://github.com/llamastack/llama-stack/issues/4896
    storage:
      backends:
        kv_default:
          type: kv_postgres
          host: ${env.POSTGRES_HOST}
          port: "${env.POSTGRES_PORT}"
          db: ${env.POSTGRES_DB}
          user: ${env.POSTGRES_USER}
          password: ${env.POSTGRES_PASSWORD}
          table_name: llamastack_kvstore
        sql_default:
          type: sql_postgres
          host: ${env.POSTGRES_HOST}
          port: "${env.POSTGRES_PORT}"
          db: ${env.POSTGRES_DB}
          user: ${env.POSTGRES_USER}
          password: ${env.POSTGRES_PASSWORD}
          table_name: llamastack_sqlstore
      stores:
        metadata:
          namespace: registry
          backend: kv_default
        inference:
          table_name: inference_store
          backend: sql_default
        conversations:
          table_name: openai_conversations
          backend: sql_default
        prompts:
          namespace: prompts
          backend: kv_default
    # llama-stack 0.6.x rewrote the Vertex AI provider (remote::vertexai) to use
    # the google-genai SDK directly. Model names must match the SDK-native format
    # exactly for model registration to succeed. For Vertex AI, the SDK returns
    # the full resource-name format (e.g., "publishers/google/models/gemini-2.5-flash").
    # See: https://github.com/meta-llama/llama-stack/pull/5169
    # The registered models mirror the Gemini LLMs in the org's
    # vertexai.allowedModels policy (RSPEED-3221). The default is
    # gemini-3.5-flash. NOTE: plain gemini-2.5-flash is NOT in the allow
    # list, so inference against it is rejected by org policy; it is kept
    # registered for now and should be removed once nothing references it.
    models:
      - metadata: {}
        model_id: publishers/google/models/gemini-2.5-flash
        provider_id: google-vertex
        provider_model_id: publishers/google/models/gemini-2.5-flash
        model_type: llm
      # gemini-2.5-flash discontinues June 17, 2026; gemini-3-flash is the
      # planned successor (RSPEED-2796).
      - metadata: {}
        model_id: publishers/google/models/gemini-3.5-flash
        provider_id: google-vertex
        provider_model_id: publishers/google/models/gemini-3.5-flash
        model_type: llm
      - metadata: {}
        model_id: publishers/google/models/gemini-3-flash
        provider_id: google-vertex
        provider_model_id: publishers/google/models/gemini-3-flash
        model_type: llm
      - metadata: {}
        model_id: publishers/google/models/gemini-3.1-pro
        provider_id: google-vertex
        provider_model_id: publishers/google/models/gemini-3.1-pro
        model_type: llm
      - metadata: {}
        model_id: publishers/google/models/gemini-3.1-pro-preview
        provider_id: google-vertex
        provider_model_id: publishers/google/models/gemini-3.1-pro-preview
        model_type: llm
      - metadata: {}
        model_id: publishers/google/models/gemini-3-1-flash-lite
        provider_id: google-vertex
        provider_model_id: publishers/google/models/gemini-3-1-flash-lite
        model_type: llm
      - metadata: {}
        model_id: publishers/google/models/gemini-2.5-pro
        provider_id: google-vertex
        provider_model_id: publishers/google/models/gemini-2.5-pro
        model_type: llm
      - metadata: {}
        model_id: publishers/google/models/gemini-2.5-flash-lite
        provider_id: google-vertex
        provider_model_id: publishers/google/models/gemini-2.5-flash-lite
        model_type: llm
    server:
      port: 8321
