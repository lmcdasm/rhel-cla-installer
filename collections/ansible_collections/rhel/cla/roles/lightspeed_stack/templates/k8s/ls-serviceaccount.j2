apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ ls_name }}
{% if cla_namespace | default('') %}
  namespace: {{ cla_namespace }}
{% endif %}
  labels:
    service: rhel-lightspeed
    app: {{ ls_name }}
    app.kubernetes.io/part-of: rhel-cla
{% if cla_pull_secret_name | default('') %}
imagePullSecrets:
  - name: {{ cla_pull_secret_name }}
{% endif %}
