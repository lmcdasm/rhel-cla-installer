# {{ ansible_managed }}
[Unit]
Description=Lightspeed Stack

[Container]
Image={{ ls_name }}.image
ContainerName={{ ls_name }}
Pod={{ cla_pod_name }}.pod
Exec=--config /app-root/lightspeed-stack.yml
{% if ls_provider == "vertex" %}
Secret={{ ls_providers.vertex.credentials_secret_name }},target=/run/secrets/{{ ls_providers.vertex.credentials_secret_name }},mode=440
Environment=GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/{{ ls_providers.vertex.credentials_secret_name }}
{% endif %}

{% for file in ls_config_files %}
Volume={{ ls_config_dir }}/{{ file | basename | replace('-' ~ _ls_major_version, '') }}:/app-root/{{ file | basename |replace('-' ~ _ls_major_version, '') }}:Z,ro
{% endfor %}

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
