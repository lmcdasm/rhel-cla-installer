apiVersion: v1
kind: ResourceQuota
metadata:
  name: rhel-cla-quota
  namespace: {{ cla_namespace }}
  labels:
    app.kubernetes.io/part-of: rhel-cla
spec:
  hard:
    pods: "{{ cla_quota_pods }}"
    requests.cpu: "{{ cla_quota_requests_cpu }}"
    requests.memory: {{ cla_quota_requests_memory }}
    limits.cpu: "{{ cla_quota_limits_cpu }}"
    limits.memory: {{ cla_quota_limits_memory }}
    persistentvolumeclaims: "{{ cla_quota_pvcs }}"
    requests.storage: {{ cla_quota_storage }}
---
apiVersion: v1
kind: LimitRange
metadata:
  name: rhel-cla-limits
  namespace: {{ cla_namespace }}
  labels:
    app.kubernetes.io/part-of: rhel-cla
spec:
  limits:
    - type: Container
      defaultRequest:
        cpu: 100m
        memory: 128Mi
      default:
        cpu: "1"
        memory: 1Gi
      max:
        cpu: "4"
        memory: 8Gi
    - type: PersistentVolumeClaim
      max:
        storage: 50Gi
      min:
        storage: 1Gi
