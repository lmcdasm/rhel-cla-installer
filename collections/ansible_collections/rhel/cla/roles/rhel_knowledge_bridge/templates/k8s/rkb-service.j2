apiVersion: v1
kind: Service
metadata:
  name: {{ rkb_name }}
{% if cla_namespace | default('') %}
  namespace: {{ cla_namespace }}
{% endif %}
  labels:
    service: rhel-lightspeed
    app: {{ rkb_name }}
    app.kubernetes.io/part-of: rhel-cla
spec:
  selector:
    app: {{ rkb_name }}
  ports:
    - name: mcp
      port: {{ rkb_port }}
      targetPort: mcp
      protocol: TCP
