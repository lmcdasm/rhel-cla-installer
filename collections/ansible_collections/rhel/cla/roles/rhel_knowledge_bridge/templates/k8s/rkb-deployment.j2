apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ rkb_name }}
{% if cla_namespace | default('') %}
  namespace: {{ cla_namespace }}
{% endif %}
  labels:
    service: rhel-lightspeed
    app: {{ rkb_name }}
    app.kubernetes.io/part-of: rhel-cla
spec:
  replicas: {{ rkb_replicas }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: {{ rkb_name }}
  template:
    metadata:
      labels:
        service: rhel-lightspeed
        app: {{ rkb_name }}
        app.kubernetes.io/part-of: rhel-cla
    spec:
      serviceAccountName: {{ rkb_name }}
      containers:
        - name: {{ rkb_name }}
{% if rkb_container_image_digest | default('') %}
          image: {{ rkb_container_image }}@{{ rkb_container_image_digest }}
{% else %}
          image: {{ rkb_container_image }}:{{ rkb_container_image_tag }}
{% endif %}
          imagePullPolicy: IfNotPresent
          ports:
            - name: mcp
              containerPort: {{ rkb_port }}
              protocol: TCP
          env:
            - name: MCP_TRANSPORT
              value: "{{ rkb_transport }}"
            - name: MCP_PORT
              value: "{{ rkb_port }}"
            - name: MCP_LOG_LEVEL
              value: "{{ rkb_log_level }}"
            - name: MCP_SOLR_URL
              value: "{{ rkb_solr_url }}"
{% if rkb_exclude_kbase | bool %}
            - name: MCP_EXCLUDE_KBASE
              value: "true"
{% endif %}
          livenessProbe:
            tcpSocket:
              port: mcp
            initialDelaySeconds: 10
            periodSeconds: 10
            failureThreshold: 3
          readinessProbe:
            tcpSocket:
              port: mcp
            initialDelaySeconds: 5
            periodSeconds: 10
            failureThreshold: 3
          resources:
            requests:
              cpu: {{ rkb_cpu_request }}
              memory: {{ rkb_memory_request }}
            limits:
              cpu: {{ rkb_cpu_limit }}
              memory: {{ rkb_memory_limit }}
